[Desktop Entry]
Type=Application
Version=1.0
Name=uvcan
GenericName=CANopen device manager
Comment=Open a Usevolt CANopen package
# @BIN@ is replaced by install.sh with the installed uvcan-open wrapper path.
# The wrapper runs `uvcan --sys <file> --ui` for a .uvsys system package,
# `uvcan --dev <file> --ui` for a .uvdev device package, and plain `uvcan --ui`
# when launched with no file, so the entry is safe to start from the menu too.
Exec=@BIN@ %f
Terminal=false
Icon=application-x-uvsys
MimeType=application/x-uvsys;application/x-uvdev;
Categories=Development;Electronics;
Keywords=uvcan;CANopen;Usevolt;uvsys;uvdev;
